{
  "name": "taekwondo-registration-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n \"VITE,PAGES\" -c \"blue,magenta\" \"vite\" \"wrangler pages dev dist --compatibility-date=2026-11-01 --d1=DB=taekwondo-db --r2=R2_BUCKET=taekwondo-docs\"",
    "build": "vite build",
    "seed": "wrangler d1 execute taekwondo-db --local --file=migrations/0002_seed_demo_data.sql",
    "seed:remote": "wrangler d1 execute taekwondo-db --remote --file=migrations/0002_seed_demo_data.sql",
    "test": "node test/self-check.mjs",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-11-01 --d1=DB=taekwondo-db --r2=R2_BUCKET=taekwondo-docs"
  },
  "dependencies": {
    "hono": "^4.6.12",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-vue-next": "^0.460.0",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^3.91.0"
  }
}
