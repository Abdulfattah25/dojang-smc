# ==========================================================
# Frontend Environment Variables (Vite)
# ==========================================================
# Cloudflare Turnstile Site Key (Public)
# Testing Key (Always Passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ==========================================================
# Backend Variables (Cloudflare Pages Functions / Wrangler)
# Catatan: Untuk 'wrangler pages dev', variabel ini juga dimuat dari .dev.vars
# ==========================================================
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=2

# JWT Secret untuk sesi login admin (Ganti dengan string acak panjang di production)
JWT_SECRET=smc-secret-key-satria-muda-club-2026-very-secure

# Cloudflare Turnstile Secret Key (Private)
# Testing Secret (Always Passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
